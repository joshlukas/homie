# Beispiel-Einstellungen für Homie. Nichts davon ist nötig – Homie startet auch ohne diese Datei.
# Zum Ändern: als ".env" neben docker-compose.yml kopieren (Compose-Weg)
# oder die Werte in Portainer unter "Environment variables" des Stacks eintragen.
# Die Datei .env gehört nie ins Repository (steht in .gitignore).

# Port, unter dem Homie im Heimnetz erreichbar ist
HOMIE_PORT=8090

# Nur lesender Docker-Zugriff für die Erkundung: 1 = an, 0 = aus (der Zwischendienst startet dann gar nicht)
HOMIE_DOCKER_LESEN=1

# Port des Zwischendienstes, nur auf dem Rechner selbst erreichbar (127.0.0.1)
HOMIE_DOCKER_PORT=23750

# Freiwillig: eigener Hauptschlüssel für die verschlüsselte Ablage.
# Leer = Homie erzeugt selbst einen und legt ihn im Datenordner ab.
# Gesetzt = eine kopierte Datensicherung allein lässt sich nicht entschlüsseln. Gut aufbewahren:
# ohne ihn sind die eingetragenen Schlüssel verloren (dann einfach neu eintragen).
HOMIE_MASTER_KEY=

# Freiwillig, nur wenn Yamtrack auf demselben Rechner läuft: Gesehenes aus Sprachnotizen in Yamtrack eintragen.
# 1 startet dafür einen kleinen Helfer mit Docker-Zugang (siehe docker-compose.yml). 0 = aus.
HOMIE_YAMTRACK_SCHREIBEN=0
# Name des Yamtrack-Containers und Port des Helfers (nur auf dem Rechner selbst erreichbar)
HOMIE_YAMTRACK_CONTAINER=yamtrack
HOMIE_YAMTRACK_PORT=23751

# Freiwillig: Bild des Tages auf „Mein Tag“. Bilder (jpg, png, webp, gif, avif) liegen im Volume „homie-bilder“.
# 1 gibt diesen Ordner zusätzlich im Heimnetz als Windows-Freigabe frei (smb://<Rechner>/bilder), zum Lesen und
# Schreiben und OHNE Passwort – nur einschalten, wenn allen Geräten im Heimnetz vertraut wird. 0 = aus.
HOMIE_BILDER_FREIGABE=0
# Port der Freigabe (445 ist der übliche; nur ändern, wenn auf dem Rechner schon eine Freigabe läuft)
HOMIE_BILDER_PORT=445

# Freiwillig, nur wenn Homie hinter einem Reverse Proxy läuft (z. B. Nginx Proxy Manager): dessen Adresse oder Netz,
# mehrere durch Kommas getrennt, z. B. 192.0.2.10 oder ein ganzes Docker-Netz in der Form a.b.0.0/16.
# Dann gilt die Bremse gegen falsche Passwörter je Gerät (Kopfzeile X-Forwarded-For) statt für alle zugleich.
# Nur Adressen eintragen, die wirklich der Proxy sind – allen anderen glaubt Homie diese Kopfzeile nicht.
HOMIE_PROXY=

# Zeitzone
TZ=Europe/Berlin
