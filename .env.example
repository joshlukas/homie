# Beispiel-Einstellungen für Homie. Nichts davon ist nötig – Homie startet auch ohne diese Datei.
# Zum Ändern: als ".env" neben docker-compose.yml kopieren (Compose-Weg)
# oder die Werte in Portainer unter "Environment variables" des Stacks eintragen.
# Die Datei .env gehört nie ins Repository (steht in .gitignore).

# Port, unter dem Homie im Heimnetz erreichbar ist
HOMIE_PORT=8090

# Nur lesender Docker-Zugriff für die Erkundung: 1 = an, 0 = aus (der Zwischendienst startet dann gar nicht)
HOMIE_DOCKER_LESEN=1

# Port des Zwischendienstes, nur auf dem Rechner selbst erreichbar (127.0.0.1)
HOMIE_DOCKER_PORT=23750

# Freiwillig: eigener Hauptschlüssel für die verschlüsselte Ablage.
# Leer = Homie erzeugt selbst einen und legt ihn im Datenordner ab.
# Gesetzt = eine kopierte Datensicherung allein lässt sich nicht entschlüsseln. Gut aufbewahren:
# ohne ihn sind die eingetragenen Schlüssel verloren (dann einfach neu eintragen).
HOMIE_MASTER_KEY=

# Zeitzone
TZ=Europe/Berlin
